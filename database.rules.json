{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "blocks": {
          ".indexOn": ["createdAt", "updatedAt"]
        },
        "todos": {
          ".indexOn": ["blockId", "createdAt", "updatedAt"]
        },
        "files": {
          ".indexOn": ["blockId", "createdAt"]
        }
      }
    }
  }
}
